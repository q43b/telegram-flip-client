# Release signing. Copy this file to keystore.properties (same folder) and fill it in.
# keystore.properties is git-ignored: it holds your key's passwords. Never commit it.
# Without it, release builds are simply left unsigned; dev builds don't need it at all.

# Full path to the key file, with forward slashes
storeFile=C:/Users/YOU/keystores/tgflip-release.jks
storePassword=CHANGE_ME
keyAlias=tgflip
keyPassword=CHANGE_ME
