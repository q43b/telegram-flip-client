<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Recording voice messages; asked for the first time one is recorded -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application
        android:name=".TGFlipApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TGFlip">
        <!-- Japanese Android flip phones (NextFP): the system's own soft key labels at the
             bottom of the screen. Optional, so the app still installs everywhere else. -->
        <uses-library android:name="com.nextfp.android.util" android:required="false" />
        <!-- configChanges: opening or closing the flip switches the phone's keyboard state.
             By default Android would rebuild the open screen each time, losing a reply in
             progress and reconnecting; listing them here keeps the screen as it is. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TopicsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
        <activity
            android:name=".ChatActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
        <activity
            android:name=".GroupInfoActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
        <activity
            android:name=".SettingsGroupActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="false" />
    </application>

</manifest>