<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom tabs on the chat list and settings screens; TabBar.kt highlights the active one -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:tag="theme:bar"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tab_chats"
        android:tag="theme:tab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:focusable="false"
        android:gravity="center"
        android:paddingVertical="2dp"
        android:text="@string/tab_chats" />

    <TextView
        android:id="@+id/tab_settings"
        android:tag="theme:tab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:focusable="false"
        android:gravity="center"
        android:paddingVertical="2dp"
        android:text="@string/tab_settings" />

</LinearLayout>
