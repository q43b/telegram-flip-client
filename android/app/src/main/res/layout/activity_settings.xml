<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SettingsActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/settings_screen_title"
        android:textStyle="bold" />

    <!-- One row per setting; OK opens it -->
    <com.q43b.tgflip.WrapListView
        android:id="@+id/settings_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Small gray 'TG Flip 1.0.0 "Melted"' line. Down from the last row reaches
         it; there F2 opens this version's release notes and OK "Under the hood". Its focus frame and colors
         come from the theme (Themer, role secondary). -->
    <TextView
        android:id="@+id/app_version"
        android:tag="theme:secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:gravity="center"
        android:padding="4dp"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <include layout="@layout/tab_bar" />

    <!-- "Release notes" over F2 while the version line has focus (as text only on phones
         without their own soft key boxes) -->
    <include layout="@layout/soft_key_bar" />

</LinearLayout>
