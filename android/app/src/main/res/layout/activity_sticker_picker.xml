<?xml version="1.0" encoding="utf-8"?>
<!-- F2 > Stickers: first the list of packs, then one pack's stickers as a grid -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".StickerPickerActivity">

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:visibility="gone" />

    <com.q43b.tgflip.WrapListView
        android:id="@+id/pack_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Columns as wide as StickerLoader.CHAT_SIZE_DP, so the pictures are the chat's copies -->
    <GridView
        android:id="@+id/sticker_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnWidth="104dp"
        android:gravity="center"
        android:numColumns="auto_fit"
        android:stretchMode="spacingWidth"
        android:visibility="gone" />

</LinearLayout>
