<?xml version="1.0" encoding="utf-8"?>
<!-- A chat screen row: the message's text, and for a sticker its picture on the right, the
     text wrapping in the space left of it (hidden otherwise, the text then takes the whole
     row). The text looks like Android's simple_list_item_1. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="?android:attr/listPreferredItemHeightSmall"
    android:orientation="horizontal"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">

    <TextView
        android:id="@+id/text"
        android:tag="theme:message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textAppearance="?android:attr/textAppearanceListItemSmall" />

    <!-- 96dp, as StickerLoader.CHAT_SIZE_DP -->
    <ImageView
        android:id="@+id/sticker"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

</LinearLayout>
