<?xml version="1.0" encoding="utf-8"?>
<!-- Soft key labels: left above F1, right above F2, each saying what its key does right
     now. SoftKeyBar (SoftKeys.kt) shows a label only while its key does something and
     hides the whole bar when neither does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/soft_key_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/soft_key_bar"
    android:orientation="horizontal"
    android:visibility="gone">

    <TextView
        android:id="@+id/soft_key_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:focusable="false"
        android:gravity="start"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/soft_key_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:focusable="false"
        android:gravity="end"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:visibility="invisible" />

</LinearLayout>
