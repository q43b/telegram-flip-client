<?xml version="1.0" encoding="utf-8"?>
<!-- Under the hood > Local cache: a title, the rows of one level, and the soft key bar
     ("Delete" over F2 while the highlighted row can be deleted) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".LocalCacheActivity">

    <TextView
        android:id="@+id/cache_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:padding="8dp"
        android:singleLine="true"
        android:tag="theme:title"
        android:textStyle="bold" />

    <com.q43b.tgflip.WrapListView
        android:id="@+id/cache_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/soft_key_bar" />

</LinearLayout>
