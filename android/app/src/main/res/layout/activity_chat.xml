<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ChatActivity">

    <include layout="@layout/connection_bar" />

    <TextView
        android:id="@+id/chat_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <EditText
        android:id="@+id/message_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/message_hint"
        android:imeOptions="actionSend"
        android:importantForAutofill="no"
        android:inputType="textShortMessage|textCapSentences" />

    <!-- Soft key labels: each sits above its physical key. Left (F1) is reserved for media. -->
    <TextView
        android:id="@+id/soft_key_right"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/soft_key_bar"
        android:focusable="false"
        android:gravity="end"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="@string/soft_key_mark_read"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
