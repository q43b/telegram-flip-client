<?xml version="1.0" encoding="utf-8"?>
<!-- Android blocks plain HTTP by default, and this file is fixed when the app is built,
     so it cannot follow the IPs entered in Settings. Plain HTTP is therefore allowed here,
     and the app itself decides where it goes: it only ever connects to the addresses
     entered in Settings, Local network and VPN use plain HTTP to those, and Public
     internet always uses HTTPS (see ConnectionMode.kt). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Deliberate, see above; hence lint's InsecureBaseConfiguration warning is silenced -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
