# TG Flip server settings. The packaged server writes .env on its first run;
# for running from source, copy this file to .env and fill it in. Never share .env.

# From https://my.telegram.org (API development tools)
API_ID=
API_HASH=

# The password the phone app uses (lowercase letters and digits are easiest on a keypad)
API_TOKEN=

# MTProxy, only where Telegram is blocked; leave PROXY_HOST empty to connect directly
PROXY_HOST=
PROXY_PORT=
PROXY_SECRET=

# Port the phone app connects to
PORT=9436

# private: one person's server, every account's app may see the live log ("Under the hood").
# shared: for several people; only admin accounts (set in Maintenance mode) may see it
SERVER_MODE=private
